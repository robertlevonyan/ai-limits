<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "2710"
   version = "1.7">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Install to ~/Applications and register"
               scriptText = "# Runs after every build. Installs the app to ~/Applications and runs it from there, because macOS&#10;# (widget list, Finder, Dock) doesn't reliably pick up icons/widgets of apps inside Xcode's DerivedData.&#10;APP=&quot;${BUILT_PRODUCTS_DIR}/${FULL_PRODUCT_NAME}&quot;&#10;DEST=&quot;$HOME/Applications/${FULL_PRODUCT_NAME}&quot;&#10;LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister&#10;&#10;/usr/bin/pkill -x &quot;AI Limits&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;mkdir -p &quot;$HOME/Applications&quot;&#10;rm -rf &quot;$DEST&quot;&#10;/usr/bin/ditto &quot;$APP&quot; &quot;$DEST&quot;&#10;touch &quot;$DEST&quot; &quot;$DEST/Contents/Info.plist&quot;&#10;&#10;# Only the installed copy should be registered: drop every DerivedData copy (this build and old ones).&#10;for OLD in &quot;$HOME&quot;/Library/Developer/Xcode/DerivedData/*/Build/Products/*/&quot;AI Limits.app&quot;; do&#10;  [ -d &quot;$OLD&quot; ] || continue&#10;  /usr/bin/pluginkit -r &quot;$OLD/Contents/PlugIns/AILimitsWidget.appex&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;  &quot;$LSREGISTER&quot; -u &quot;$OLD&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;done&#10;&quot;$LSREGISTER&quot; -f -R &quot;$DEST&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;/usr/bin/pluginkit -a &quot;$DEST/Contents/PlugIns/AILimitsWidget.appex&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;&#10;# Reload widget host, widget list and icon caches.&#10;/usr/bin/killall chronod NotificationCenter iconservicesagent &gt;/dev/null 2&gt;&amp;1 || true&#10;MARK=&quot;${PROJECT_TEMP_DIR}/.appicon.md5&quot;&#10;NEW=$(/sbin/md5 -q &quot;$DEST/Contents/Resources/AppIcon.icns&quot; 2&gt;/dev/null)&#10;if [ -n &quot;$NEW&quot; ] &amp;&amp; [ &quot;$NEW&quot; != &quot;$(cat &quot;$MARK&quot; 2&gt;/dev/null)&quot; ]; then&#10;  echo &quot;$NEW&quot; &gt; &quot;$MARK&quot;&#10;  /usr/bin/killall Dock Finder &gt;/dev/null 2&gt;&amp;1 || true&#10;fi&#10;"
               shellToInvoke = "/bin/sh">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "A1B2C3D4000000000000000E"
                     BuildableName = "AI Limits.app"
                     BlueprintName = "AILimits"
                     ReferencedContainer = "container:AILimits.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "A1B2C3D4000000000000000E"
               BuildableName = "AI Limits.app"
               BlueprintName = "AILimits"
               ReferencedContainer = "container:AILimits.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES">
      <Testables>
      </Testables>
   </TestAction>
   <LaunchAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      launchStyle = "0"
      useCustomWorkingDirectory = "NO"
      ignoresPersistentStateOnLaunch = "NO"
      debugDocumentVersioning = "YES"
      debugServiceExtension = "internal"
      allowLocationSimulation = "YES">
      <PathRunnable
         runnableDebuggingMode = "0"
         FilePath = "/Users/robert/Applications/AI Limits.app">
      </PathRunnable>
      <MacroExpansion>
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "A1B2C3D4000000000000000E"
            BuildableName = "AI Limits.app"
            BlueprintName = "AILimits"
            ReferencedContainer = "container:AILimits.xcodeproj">
         </BuildableReference>
      </MacroExpansion>
   </LaunchAction>
   <ProfileAction
      buildConfiguration = "Release"
      shouldUseLaunchSchemeArgsEnv = "YES"
      savedToolIdentifier = ""
      useCustomWorkingDirectory = "NO"
      debugDocumentVersioning = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "A1B2C3D4000000000000000E"
            BuildableName = "AI Limits.app"
            BlueprintName = "AILimits"
            ReferencedContainer = "container:AILimits.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </ProfileAction>
   <AnalyzeAction
      buildConfiguration = "Debug">
   </AnalyzeAction>
   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
   </ArchiveAction>
</Scheme>
