<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "2710"
   version = "1.7">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Keep Xcode builds out of the Apps list"
               scriptText = "# Runs after Debug builds in Xcode. Keeps Xcode's build out of Launchpad / the Apps list and the widget&#10;# gallery, so the installed app (from a GitHub release) is the only AI Limits macOS lists and uses.&#10;[ &quot;${CI:-}&quot; = &quot;true&quot; ] &amp;&amp; exit 0&#10;[ &quot;${CONFIGURATION}&quot; = &quot;Debug&quot; ] || exit 0&#10;LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister&#10;&#10;# Unregister every Xcode build of the app (this one and builds from older project locations).&#10;for B in &quot;$HOME&quot;/Library/Developer/Xcode/DerivedData/*/Build/Products/*/&quot;${FULL_PRODUCT_NAME}&quot;; do&#10;  [ -d &quot;$B&quot; ] || continue&#10;  /usr/bin/pluginkit -r &quot;$B/Contents/PlugIns/AILimitsWidget.appex&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;  &quot;$LSREGISTER&quot; -u &quot;$B&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;done&#10;&#10;# Keep the installed copy registered (its widgets stay in the gallery).&#10;for INST in &quot;/Applications/${FULL_PRODUCT_NAME}&quot; &quot;$HOME/Applications/${FULL_PRODUCT_NAME}&quot;; do&#10;  [ -d &quot;$INST&quot; ] || continue&#10;  &quot;$LSREGISTER&quot; -f -R &quot;$INST&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;  /usr/bin/pluginkit -a &quot;$INST/Contents/PlugIns/AILimitsWidget.appex&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;done&#10;/usr/bin/killall chronod &gt;/dev/null 2&gt;&amp;1 || true&#10;"
               shellToInvoke = "/bin/sh">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "A1B2C3D4000000000000000E"
                     BuildableName = "AI Limits.app"
                     BlueprintName = "AILimits"
                     ReferencedContainer = "container:AILimits.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "A1B2C3D4000000000000000E"
               BuildableName = "AI Limits.app"
               BlueprintName = "AILimits"
               ReferencedContainer = "container:AILimits.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES">
      <Testables>
      </Testables>
   </TestAction>
   <LaunchAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      launchStyle = "0"
      useCustomWorkingDirectory = "NO"
      ignoresPersistentStateOnLaunch = "NO"
      debugDocumentVersioning = "YES"
      debugServiceExtension = "internal"
      allowLocationSimulation = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "A1B2C3D4000000000000000E"
            BuildableName = "AI Limits.app"
            BlueprintName = "AILimits"
            ReferencedContainer = "container:AILimits.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </LaunchAction>
   <ProfileAction
      buildConfiguration = "Release"
      shouldUseLaunchSchemeArgsEnv = "YES"
      savedToolIdentifier = ""
      useCustomWorkingDirectory = "NO"
      debugDocumentVersioning = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "A1B2C3D4000000000000000E"
            BuildableName = "AI Limits.app"
            BlueprintName = "AILimits"
            ReferencedContainer = "container:AILimits.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </ProfileAction>
   <AnalyzeAction
      buildConfiguration = "Debug">
   </AnalyzeAction>
   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
   </ArchiveAction>
</Scheme>
